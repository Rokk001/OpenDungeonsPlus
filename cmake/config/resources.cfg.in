[Graphics]
@OD_OGRE_SHADER_RESOURCES@
FileSystem=materials/scripts
FileSystem=materials/scripts/Creatures
FileSystem=materials/textures
FileSystem=materials/textures/loading
FileSystem=materials/textures/menu
FileSystem=models
FileSystem=particles
FileSystem=shaders

# Internal shadow programs must also be visible to OGRE's global resource pool.
# Main is listed only here: OGRE 14 defines shared parameter sets in its scripts, so a second group would load them twice.
[OgreInternal]
FileSystem=@OD_OGRE_MEDIA_DIR@/RTShaderLib/../Main

[GUI]
FileSystem=gui
FileSystem=gui/fonts
FileSystem=gui/schemas

[Music]
FileSystem=music

[Sound]
FileSystem=sounds

// Original fortress materials; colours belong to the surfaces, lights to the scene.
import RTSS/NormalMapping_MultiPass from "RTShaderSystem.material"

material MenuStone : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            texture_unit
            {
                texture menu/MenuStoneNormal.png
                tex_address_mode wrap
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
        }
        pass decal
        {
            ambient 0.8 0.8 0.8 1
            diffuse 0.8 0.8 0.8 1
            specular 0.08 0.08 0.08 1 24
            texture_unit decalmap
            {
                texture menu/MenuStone.png
                tex_address_mode wrap
            }
        }
    }
}

material MenuDarkStone
{
    technique
    {
        pass
        {
            ambient 0.11 0.12 0.13 1
            diffuse 0.11 0.12 0.13 1
        }
    }
}

material MenuIron
{
    technique
    {
        pass
        {
            ambient 0.14 0.15 0.16 1
            diffuse 0.14 0.15 0.16 1
            specular 0.22 0.23 0.24 1 28
        }
    }
}

material MenuWood
{
    technique
    {
        pass
        {
            ambient 0.18 0.11 0.07 1
            diffuse 0.18 0.11 0.07 1
        }
    }
}

material MenuParchment
{
    technique
    {
        pass
        {
            ambient 0.42 0.36 0.25 1
            diffuse 0.42 0.36 0.25 1
        }
    }
}

material MenuBlack
{
    technique
    {
        pass
        {
            ambient 0.012 0.014 0.016 1
            diffuse 0.012 0.014 0.016 1
        }
    }
}

material MenuCloth
{
    technique
    {
        pass
        {
            cull_hardware none
            ambient 0.25 0.025 0.028 1
            diffuse 0.25 0.025 0.028 1
        }
    }
}

material MenuEmber
{
    technique
    {
        pass
        {
            ambient 0.9 0.16 0.015 1
            diffuse 0.9 0.16 0.015 1
            emissive 0.9 0.16 0.015
        }
    }
}

material MenuCrystal
{
    technique
    {
        pass
        {
            ambient 0.035 0.45 0.055 1
            diffuse 0.035 0.45 0.055 1
            emissive 0.035 0.45 0.055
        }
    }
}

material MenuMountain
{
    technique
    {
        pass
        {
            lighting off
            ambient 0.055 0.065 0.07 1
            diffuse 0.055 0.065 0.07 1
            emissive 0.055 0.065 0.07
        }
    }
}

material MenuCloud
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none
            ambient 0.035 0.043 0.049 1
            diffuse 0.035 0.043 0.049 1
            emissive 0.035 0.043 0.049
        }
    }
}

material MenuSky
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none
            ambient 0.012 0.018 0.022 1
            diffuse 0.012 0.018 0.022 1
            emissive 0.012 0.018 0.022
        }
    }
}

material MenuCampaignMap
{
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 0.8 0.8 0.8 1
            texture_unit
            {
                texture menu/MenuCampaignMap.png
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}

// The courtyard keeps the same dark stone while shallow highlights suggest rain.
material MenuWetStone : MenuStone
{
    technique
    {
        pass
        {
            specular 0.28 0.29 0.30 1 36
        }
    }
}

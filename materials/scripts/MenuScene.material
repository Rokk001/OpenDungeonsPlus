// Explicit atmosphere programs preserve authored linear emission on the game display target.
vertex_program MenuSkyVertex glsl
{
    source MenuSky.vert
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto worldMatrix world_matrix
    }
}

fragment_program MenuSkyFragment glsl
{
    source MenuSky.frag
    default_params
    {
        param_named_auto surfaceEmission surface_emissive_colour
        param_named atmosphereKind int 0
        param_named moonMap int 0
    }
}

// Original fortress materials; colours belong to the surfaces, lights to the scene.
import RTSS/NormalMapping_MultiPass from "RTShaderSystem.material"

material MenuStone : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            texture_unit decalmap { texture MenuFortressStone.png }
            texture_unit
            {
                texture MenuFortressStoneNormal.png
                tex_address_mode wrap
                rtshader_system
                {
                    normal_map tangent_space
                }
            }
            ambient 0.85 0.85 0.85 1
            diffuse 0.85 0.85 0.85 1
            specular 0.10 0.10 0.09 1 32
        }
    }
}

material MenuDarkStone : MenuStone
{
    technique
    {
        pass lighting
        {
            ambient 0.48 0.50 0.52 1
            diffuse 0.48 0.50 0.52 1
            specular 0.06 0.06 0.05 1 24
        }
    }
}

material MenuIron : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            texture_unit decalmap { texture MenuRustIron.png }
            texture_unit
            {
                texture MenuRustIronNormal.png
                tex_address_mode wrap
                rtshader_system { normal_map tangent_space }
            }
            ambient 0.72 0.72 0.72 1
            diffuse 0.72 0.72 0.72 1
            specular 0.22 0.23 0.24 1 28
        }
    }
}

material MenuWood
{
    technique
    {
        pass
        {
            ambient 0.18 0.11 0.07 1
            diffuse 0.18 0.11 0.07 1
        }
    }
}

material MenuParchment
{
    technique
    {
        pass
        {
            ambient 0.42 0.36 0.25 1
            diffuse 0.42 0.36 0.25 1
        }
    }
}

material MenuBlack
{
    technique
    {
        pass
        {
            ambient 0.012 0.014 0.016 1
            diffuse 0.012 0.014 0.016 1
        }
    }
}

material MenuCloth : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            cull_hardware none
            texture_unit decalmap { texture MenuTornCloth.png }
            texture_unit
            {
                texture MenuTornClothNormal.png
                tex_address_mode wrap
                rtshader_system { normal_map tangent_space }
            }
            cull_hardware none
            ambient 0.85 0.85 0.85 1
            diffuse 0.85 0.85 0.85 1
            specular 0.025 0.025 0.025 1 6
        }
    }
}

material MenuEmber
{
    technique
    {
        pass
        {
            ambient 0.9 0.16 0.015 1
            diffuse 0.9 0.16 0.015 1
            emissive 0.9 0.16 0.015
        }
    }
}

material MenuCrystal
{
    technique
    {
        pass
        {
            ambient 0.035 0.45 0.055 1
            diffuse 0.035 0.45 0.055 1
            emissive 0.018 0.32 0.025
        }
    }
}

material MenuMountain
{
    technique
    {
        pass
        {
            lighting on
            ambient 0.012 0.016 0.022 1
            diffuse 0.012 0.016 0.022 1
            emissive 0 0 0
        }
    }
}

material MenuCloud
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            vertex_program_ref MenuSkyVertex {}
            fragment_program_ref MenuSkyFragment
            {
                param_named atmosphereKind int 2
            }

            scene_blend alpha_blend
            depth_write off
            cull_hardware none
            ambient 0 0 0 1
            diffuse 0 0 0 0
            emissive 0.035 0.043 0.049
        }
    }
}

// The sky dome has no texture and no vertex colours. An unlit fixed pass falls back to white.
// Its explicit shader keeps the upper sky nearly black; cloud structure belongs to the horizon.
material MenuSky
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            vertex_program_ref MenuSkyVertex {}
            fragment_program_ref MenuSkyFragment
            {
                param_named atmosphereKind int 0
            }

            cull_hardware none
            ambient 0 0 0 1
            diffuse 0 0 0 1
            specular 0 0 0 1 0
            emissive 0.0006 0.0005 0.0004
        }
    }
}

material MenuCampaignMap
{
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 0.8 0.8 0.8 1
            texture_unit
            {
                texture MenuCampaignMap.png
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}

// The courtyard keeps the same dark stone while shallow highlights suggest rain.
material MenuWetStone : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            texture_unit decalmap { texture MenuWetPaving.png }
            texture_unit
            {
                texture MenuWetPavingNormal.png
                tex_address_mode wrap
                rtshader_system { normal_map tangent_space }
            }
            ambient 0.92 0.92 0.92 1
            diffuse 0.92 0.92 0.92 1
            specular 0.65 0.65 0.65 1 64
        }
    }
}

// Original fire and slit-window values for the dark fortress scene.
material MenuWindowGlow
{
    technique { pass { ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.35 0.045 0.004
    } }
}
material MenuFlame
{
    technique { pass { ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 1.0 0.12 0.008
    } }
}
material MenuFlameCore
{
    technique { pass { ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 1.0 0.42 0.035
    } }
}
material MenuCrystalDark
{
    technique { pass {
        ambient 0.004 0.08 0.008 1
        diffuse 0.004 0.08 0.008 1
        emissive 0.004 0.06 0.007
    } }
}
material MenuCrystalBright
{
    technique { pass {
        ambient 0.07 0.65 0.025 1
        diffuse 0.07 0.65 0.025 1
        emissive 0.04 0.6 0.02
    } }
}

// Distant towers keep a near-black response beneath the storm-cloud light.
material MenuDistantStone
{
    technique { pass {
        ambient 0.018 0.019 0.018 1
        diffuse 0.09 0.095 0.09 1
        specular 0 0 0 1 1
    } }
}

// Dark textured carved stone keeps the guardians stone-coloured under local firelight.
material MenuCarvedStone : MenuStone
{
    technique
    {
        pass lighting
        {
            ambient 0.80 0.82 0.84 1
            diffuse 0.80 0.82 0.84 1
            specular 0.03 0.03 0.03 1 8
        }
    }
}

// Fibrous cracked guardian stone has its own albedo and matching tangent-space normals.
material MenuDemonStone : RTSS/NormalMapping_MultiPass
{
    technique
    {
        pass lighting
        {
            texture_unit decalmap { texture MenuDemonStone.png }
            texture_unit
            {
                texture MenuDemonStoneNormal.png
                tex_address_mode wrap
                rtshader_system { normal_map tangent_space }
            }
            ambient 0.82 0.82 0.82 1
            diffuse 0.82 0.82 0.82 1
            specular 0.09 0.09 0.09 1 18
        }
    }
}

// Rough dark textured stone replaces the untextured foreground rubble surfaces.
material MenuRoughStone : MenuStone
{
    technique
    {
        pass lighting
        {
            ambient 0.78 0.80 0.82 1
            diffuse 0.78 0.80 0.82 1
            specular 0.025 0.025 0.025 1 6
        }
    }
}

// Soot and fire-blackened fissures remain dark surface marks without emitted light.
material MenuSoot
{
    technique { pass {
        ambient 0.009 0.007 0.005 1
        diffuse 0.009 0.007 0.005 1
        specular 0.004 0.004 0.004 1 4
    } }
}

// Irregular rain pools collect in sunken courtyard joints and catch only local scene light.
material MenuPuddle : MenuWetStone
{
    technique
    {
        pass lighting
        {
            ambient 0.55 0.55 0.52 1
            diffuse 0.55 0.55 0.52 1
            specular 0.42 0.42 0.40 1 64
        }
    }
}

// Damp moss gathers in broken joints; its colour is a dark surface response, never light.
material MenuMoss : MenuStone
{
    technique { pass lighting {
        ambient 0.052 0.052 0.032 1
        diffuse 0.052 0.052 0.032 1
        specular 0.012 0.012 0.008 1 5
    } }
}

// Muted mineral lichen occupies weathered stone recesses and retains the stone grain.
material MenuLichen : MenuStone
{
    technique { pass lighting {
        ambient 0.08 0.07 0.05 1
        diffuse 0.08 0.07 0.05 1
        specular 0.012 0.012 0.010 1 5
    } }
}

// Rain runoff darkens irregular tracks beneath broken masonry without emitting light.
material MenuWaterStain : MenuStone
{
    technique { pass lighting {
        ambient 0.050 0.045 0.040 1
        diffuse 0.050 0.045 0.040 1
        specular 0.14 0.13 0.11 1 40
    } }
}

// Exposed chipped faces remain dark and granular rather than clean pale cut stone.
material MenuChippedStone : MenuStone
{
    technique { pass lighting {
        ambient 0.83 0.83 0.77 1
        diffuse 0.83 0.83 0.77 1
        specular 0.018 0.018 0.016 1 6
    } }
}

// Rotten timber and broken weapon handles retain grain in a subdued weathered brown.
material MenuAgedWood : MenuStone
{
    technique { pass lighting {
        ambient 0.085 0.066 0.045 1
        diffuse 0.085 0.066 0.045 1
        specular 0.010 0.009 0.007 1 5
    } }
}

// Uneven corroded iron catches fire only at worn edges; rust is not emissive.
material MenuCorrodedIron : MenuIron
{
    technique { pass lighting {
        ambient 0.56 0.51 0.45 1
        diffuse 0.56 0.51 0.45 1
        specular 0.07 0.06 0.05 1 8
    } }
}

// Old courtyard bones are stained dark by soil and rain instead of bright clean ivory.
material MenuBone : MenuStone
{
    technique { pass lighting {
        ambient 0.62 0.52 0.37 1
        diffuse 0.62 0.52 0.37 1
        specular 0.010 0.009 0.007 1 5
    } }
}

// Independent desaturated red remnants keep the two torn banners visibly different.
material MenuClothFadedA : MenuCloth
{
    technique { pass lighting {
        ambient 0.78 0.70 0.64 1
        diffuse 0.78 0.70 0.64 1
    } }
}
material MenuClothFadedB : MenuCloth
{
    technique { pass lighting {
        ambient 0.57 0.62 0.55 1
        diffuse 0.57 0.62 0.55 1
    } }
}

// Green light stays inside the ruined tower's window openings and structural fissures.
material MenuSpireGlow
{
    technique { pass { ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.008 0.65 0.035
    } }
}

// The faint additive core accompanies the wider smoke-scattered green particle shaft.
material MenuSpireBeam
{
    technique { pass { ambient 0 0 0 1
        scene_blend add
        depth_write off
        cull_hardware none
        diffuse 0 0 0 0.04
        emissive 0.001 0.035 0.003
    } }
}

// Orange heat is visible only in the broken joints between the wet flagstones.
material MenuEmberCrack
{
    technique { pass { ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.8 0.2 0.01
    } }
}

// Torn iron skull-and-blade heraldry is dried blood-red instead of clean bright paint.
material MenuBannerSymbol
{
    technique { pass {
        cull_hardware none
        ambient 0.24 0.025 0.014 1
        diffuse 0.24 0.025 0.014 1
        specular 0.08 0.025 0.014 1 24
    } }
}

// The far sky carries ember light below the mountain silhouettes, never a foreground wash.
material MenuHorizonGlow
{
    receive_shadows off
    technique { pass {
        lighting off
        vertex_program_ref MenuSkyVertex {}
        fragment_program_ref MenuSkyFragment
        {
            param_named atmosphereKind int 1
        }
        ambient 0 0 0 1
        diffuse 0 0 0 1
        cull_hardware none
        emissive 0.18 0.035 0.006
    } }
}

// A darker upper transition keeps the distant glow beneath the storm-cloud ceiling.
material MenuHorizonDark
{
    receive_shadows off
    technique { pass {
        lighting off
        vertex_program_ref MenuSkyVertex {}
        fragment_program_ref MenuSkyFragment
        {
            param_named atmosphereKind int 1
        }
        ambient 0 0 0 1
        diffuse 0 0 0 1
        cull_hardware none
        emissive 0.032 0.012 0.007
    } }
}

// Old blood is a wet, dark surface trace rather than a source of red illumination.
material MenuDriedBlood : MenuStone
{
    technique { pass lighting {
        ambient 0.36 0.014 0.008 1
        diffuse 0.36 0.014 0.008 1
        specular 0.32 0.045 0.025 1 48
    } }
}

// Slimy mineral deposits catch rain highlights only inside the existing dark stone colour.
material MenuWetSlime : MenuStone
{
    technique { pass lighting {
        ambient 0.055 0.070 0.025 1
        diffuse 0.055 0.070 0.025 1
        specular 0.25 0.28 0.16 1 48
    } }
}

// Opaque charcoal flecks and scorched remains never become bright airborne confetti.
material MenuAsh
{
    technique { pass {
        ambient 0.025 0.023 0.020 1
        diffuse 0.025 0.023 0.020 1
        specular 0 0 0 1 1
        cull_hardware none
    } }
}

// Thin dusty strands are modelled geometry, with enough surface response for local rim light.
material MenuWeb
{
    technique { pass {
        ambient 0.28 0.25 0.20 1
        diffuse 0.28 0.25 0.20 1
        specular 0.24 0.22 0.18 1 24
        cull_hardware none
    } }
}

// Crow feathers retain sharp black silhouettes and a faint wet edge under the moon.
material MenuCrowBlack : MenuIron
{
    technique { pass lighting {
        ambient 0.055 0.058 0.052 1
        diffuse 0.055 0.058 0.052 1
        specular 0.14 0.12 0.10 1 28
    } }
}

// Diseased rat hide is dark and soil-stained, with no colourful highlights.
material MenuRatHide : MenuDemonStone
{
    technique { pass lighting {
        ambient 0.20 0.15 0.095 1
        diffuse 0.20 0.15 0.095 1
        specular 0.035 0.030 0.020 1 12
    } }
}

// Desiccated trophies use the same original eroded surface with a muted dead-earth tint.
material MenuDeadSkin : MenuDemonStone
{
    technique { pass lighting {
        ambient 0.32 0.22 0.12 1
        diffuse 0.32 0.22 0.12 1
        specular 0.018 0.012 0.008 1 8
    } }
}

// The separate title decal contains the entire replaceable word and no opaque plaque background.
material MenuTitleLetters
{
    technique { pass {
        lighting off
        diffuse 1 1 1 1
        emissive 0.18 0.18 0.18
        alpha_rejection greater 96
        cull_hardware none
        texture_unit { texture MenuTitle.png
            tex_address_mode clamp
            filtering trilinear
        }
    } }
}

// The title support is old pitted iron, independent from the exchangeable lettering bitmap.
material MenuTitleIron : MenuIron
{
    technique { pass lighting {
        ambient 0.65 0.54 0.40 1
        diffuse 0.65 0.54 0.40 1
        specular 0.12 0.09 0.06 1 24
    } }
}

// The hanging crest is the only green accent away from the poisoned tower.
material MenuTitleCrest
{
    technique { pass {
        ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.009 0.32 0.025
        cull_hardware none
    } }
}

// Fractured lunar stone glows a desaturated blood red behind drifting cloud fragments.
material MenuBloodMoon
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            ambient 0.30 0.018 0.010 1
            diffuse 0.30 0.018 0.010 1
            emissive 0.22 0.013 0.006
            specular 0 0 0 1 1
            vertex_program_ref MenuSkyVertex {}
            fragment_program_ref MenuSkyFragment
            {
                param_named atmosphereKind int 3
            }
            texture_unit
            {
                texture MenuFortressStone.png
                tex_address_mode wrap
            }
        }
    }
}

// Faint eyes are embedded in darkness behind the grille rather than floating lanterns.
material MenuGateEyes
{
    technique { pass {
        ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.85 0.065 0.003
    } }
}

// Deep red heat beneath broken masonry complements the brighter courtyard ember veins.
material MenuLavaCrack
{
    technique { pass {
        ambient 0 0 0 1
        diffuse 0 0 0 1
        emissive 0.85 0.035 0.002
        cull_hardware none
    } }
}

// PC menu swarms use small cutout sprites; their quotas are capped in the particle scripts.
material MenuBatSprite
{
    technique { pass {
        lighting off
        diffuse 0.028 0.026 0.022 1
        scene_blend alpha_blend
        depth_write off
        cull_hardware none
        texture_unit { texture MenuBat.png
            tex_address_mode clamp
            filtering trilinear
        }
    } }
}
material MenuCrowSprite
{
    technique { pass {
        lighting off
        diffuse 0.035 0.030 0.025 1
        scene_blend alpha_blend
        depth_write off
        cull_hardware none
        texture_unit { texture MenuCrow.png
            tex_address_mode clamp
            filtering trilinear
        }
    } }
}

// DungeonHeartObject: the three health-tier variants of the animated heart
// (assets-src/DungeonHeartObject.blend). Kept in its own script so the
// existing DungeonTemple.material (used by the room platform mesh) is left
// untouched.
//
// The heart is lit per pixel with a tangent space normal map and a colour
// texture (both generated by tools/heart-textures, mapped by the texture
// coordinates that tools/heart-on-temple adds to the heart). The emissive term
// is only a faint glow: a strong one would hide the shading.
material DungeonHeartHealthy
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.7 0.7 0.7 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.9 0.7 1.0 1.0 18.0
            emissive 0.06 0.0 0.1 1.0

            texture_unit
            {
                texture DungeonHeartHealthy.png
                tex_address_mode wrap
                filtering trilinear
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartNormal.png tangent_space
            }
        }
    }
}

material DungeonHeartDamaged
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.7 0.7 0.7 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.3 0.3 0.3 1.0 16.0
            emissive 0.02 0.015 0.02 1.0

            texture_unit
            {
                texture DungeonHeartDamaged.png
                tex_address_mode wrap
                filtering trilinear
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartNormal.png tangent_space
            }
        }
    }
}

material DungeonHeartCritical
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.5 0.4 0.4 1.0 24.0
            emissive 0.08 0.0 0.015 1.0

            texture_unit
            {
                texture DungeonHeartCritical.png
                tex_address_mode wrap
                filtering trilinear
            }

            rtshader_system
            {
                lighting_stage normal_map DungeonHeartNormal.png tangent_space
            }
        }
    }
}

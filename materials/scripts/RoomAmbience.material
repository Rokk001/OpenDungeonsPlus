// Plain lit colours of the 3D grave vermin that crawl out of a Lich that burst (models LichBeetle, LichMaggot, LichWorm).
material LichVerminShell
{
    technique
    {
        pass
        {
            ambient 0.30 0.17 0.07 1.0
            diffuse 0.45 0.26 0.09 1.0
            specular 0.35 0.30 0.25 1.0 12.0
        }
    }
}
material LichVerminLeg
{
    technique
    {
        pass
        {
            ambient 0.14 0.08 0.04 1.0
            diffuse 0.22 0.12 0.05 1.0
        }
    }
}
material LichVerminMaggot
{
    technique
    {
        pass
        {
            ambient 0.55 0.48 0.30 1.0
            diffuse 0.80 0.70 0.46 1.0
            specular 0.30 0.30 0.25 1.0 8.0
        }
    }
}
material LichVerminWorm
{
    technique
    {
        pass
        {
            ambient 0.35 0.13 0.09 1.0
            diffuse 0.52 0.19 0.14 1.0
            specular 0.30 0.20 0.20 1.0 8.0
        }
    }
}

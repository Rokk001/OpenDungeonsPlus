// Textured, lit grave vermin that crawl out of a Lich that burst (models LichBeetle, LichMaggot, LichWorm; textures painted by
// tools/gen_lich_vermin_textures.py).
material LichVerminShell
{
    technique
    {
        pass
        {
            ambient 0.85 0.85 0.85 1.0
            diffuse 1.0 1.0 1.0 1.0
            specular 0.35 0.30 0.25 1.0 14.0
            texture_unit
            {
                texture LichVerminShell.png
            }
        }
    }
}
material LichVerminLeg
{
    technique
    {
        pass
        {
            ambient 0.14 0.08 0.04 1.0
            diffuse 0.22 0.12 0.05 1.0
        }
    }
}
material LichVerminMaggot
{
    technique
    {
        pass
        {
            ambient 0.85 0.85 0.85 1.0

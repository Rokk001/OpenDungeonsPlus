// Materials of the room ambience sprites (see particles/RoomAmbience.particle). Sprites are drawn by tools/gen_room_ambience_art.py.

material RoomAmbSpark
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbSpark.png
            }
        }
    }
}

material RoomAmbGlow
{
    technique
    {
        pass
        {
            lighting off
            // The sprite is white with its falloff in alpha: weight by alpha, or it renders as a hard disc.
            scene_blend src_alpha one
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbGlow.png
            }
        }
    }
}

material RoomAmbSmoke
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture RoomAmbSmoke.png
            }
        }
    }
}


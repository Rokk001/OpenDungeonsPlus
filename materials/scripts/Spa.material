material SpaWhistle : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            diffuse 0.46 0.46 0.44 1
            specular 0.5 0.5 0.5 1 40
        }
    }
}

material SpaEyes : RTSS/PerPixel_SinglePass
{
    technique
    {
        pass
        {
            diffuse 0.02 0.018 0.01 1
            specular 0 0 0 0 1
        }
    }
}

material SpaLavaGlow
{
    technique
    {
        pass
        {
            lighting off
            diffuse 1.0 0.15 0.015 1
            emissive 1.0 0.15 0.015
            // With lighting off the fixed pipeline ignores diffuse and emissive and paints an untextured surface white
            // (white rectangles at the pool rim): the colour has to come from the texture unit
            texture_unit
            {
                colour_op_ex source1 src_manual src_current 1.0 0.15 0.015
            }
        }
    }
}

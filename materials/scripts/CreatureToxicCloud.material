// Dedicated ability material; the existing soft smoke sprite is tinted by its particles.
material CreatureToxicCloud
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour

            texture_unit
            {
                texture ReactionParticleSmoke.png
                tex_address_mode clamp
            }
        }
    }
}

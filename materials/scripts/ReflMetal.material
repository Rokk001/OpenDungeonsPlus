// ReflMetal - reflective metal surface (spherical environment map).
// The legacy fixed-function "env_map spherical" and
// "colour_op_ex blend_manual" directives were removed in Ogre 14.x, so the
// reflection and blending are now handled by ReflMetal.vert/.frag.

vertex_program myReflMetalVertexShader glsl
{
    source ReflMetal.vert
    default_params
    {
        param_named_auto projectionMatrix projection_matrix
        param_named_auto viewMatrix view_matrix
        param_named_auto worldMatrix world_matrix
    }
}

fragment_program myReflMetalFragmentShader glsl
{
    source ReflMetal.frag
    default_params
    {
        param_named_auto ambientLightColour ambient_light_colour
        param_named_auto lightDiffuseColour light_diffuse_colour 0
        param_named_auto lightSpecularColour light_specular_colour 0
        param_named_auto lightPos light_position 0
        param_named_auto cameraPosition camera_position
    }
}

material ReflMetal
{
    technique
    {
        pass
        {
            vertex_program_ref myReflMetalVertexShader
            {
            }

            fragment_program_ref myReflMetalFragmentShader
            {
                param_named envmap int 0
                param_named ambient float3 1.0 1.0 1.0  // This will be set from C++ code
            }

            texture_unit
            {
                texture EnvmapMetal.png
            }
        }
    }
}

// Hardware skinned variant for the metal parts (the Wyvern mesh) of animated creatures.
// ReflMetal itself stays unskinned for the weapons and shields, which have no skeleton.
// RenderManager switches the ReflMetal sub entities of creatures to this material.
vertex_program myReflMetalSkinnedVertexShader glsl
{
    source ReflMetalSkinned.vert
    includes_skeletal_animation true
    default_params
    {
        param_named_auto viewProjectionMatrix viewproj_matrix
        param_named_auto boneMatrices world_matrix_array_3x4
        param_named_auto worldMatrix world_matrix
    }
}

material ReflMetalSkinned
{
    technique
    {
        shadow_caster_material CreatureShadowCaster
        pass
        {
            vertex_program_ref myReflMetalSkinnedVertexShader
            {
            }

            fragment_program_ref myReflMetalFragmentShader
            {
                param_named envmap int 0
                param_named ambient float3 1.0 1.0 1.0  // This will be set from C++ code
            }

            texture_unit
            {
                texture EnvmapMetal.png
            }
        }
    }
}

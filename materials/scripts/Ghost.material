// The flowing noise and deliberately translucent colour replace the creature's own surfaces.
material GhostGlow
{
    receive_shadows off
    technique
    {
        pass
        {
            scene_blend alpha_blend
            depth_write off
            diffuse 0.45 1.0 0.55 0.45
            emissive 0.25 0.8 0.35
            texture_unit
            {
                texture GhostNoise.png
                tex_address_mode wrap
                scroll_anim 0 0.05
            }
        }
    }
}

// Two UV halves keep the red and green lenses separate while their brightness pulses.
material GhostLamps
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            emissive 1 1 1
            texture_unit
            {
                anim_texture GhostLamps_0.png GhostLamps_1.png GhostLamps_2.png GhostLamps_3.png GhostLamps_4.png GhostLamps_5.png GhostLamps_6.png GhostLamps_7.png 2.0
                tex_address_mode clamp
                filtering trilinear
            }
        }
    }
}


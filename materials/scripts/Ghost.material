// The flexible hose from the backpack to the capture cannon (decisions 894, 936 and 998): dark ribbed rubber matching the
// pack, with physical corrugations and steel couplings. Unlit, so it never reads white in a bright room: shapeGhostHose
// in Creature.cpp gives every vertex the shaded GhostHoseColour of config/rooms.cfg, which tints the rubber texture.
// Explicit colour shaders keep the procedural hose colours on GL3Plus as well as the generated material scheme.
vertex_program GhostHoseVertex glsl
{
    source GhostHose.vert
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
    }
}
fragment_program GhostHoseFragment glsl
{
    source GhostHose.frag
    default_params
    {
        param_named rubberMap int 0
    }
}
fragment_program GhostHoseWireFragment glsl
{
    source GhostHoseWire.frag
}

material GhostHose
{
    receive_shadows off
    technique
    {
        pass
        {
            cull_hardware none
            lighting off
            ambient vertexcolour
            diffuse vertexcolour
            vertex_program_ref GhostHoseVertex { }
            fragment_program_ref GhostHoseFragment { }
            texture_unit
            {
                texture GhostPackRubber.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}

// The coloured wires wound round the hose from the pack to the cannon (decision 998): unlit vertex colours
// (GhostHoseWireColour1 to GhostHoseWireColour<GhostHoseWireCount> in config/rooms.cfg, shaded by shapeGhostHose).
material GhostHoseWire
{
    receive_shadows off
    technique
    {
        pass
        {
            cull_hardware none
            lighting off
            ambient vertexcolour
            diffuse vertexcolour
            vertex_program_ref GhostHoseVertex { }
            fragment_program_ref GhostHoseWireFragment { }
        }
    }
}


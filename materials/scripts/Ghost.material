// Mana still: bevelled copper band of the coil wound round the glass column. Its texture is laid out once round the band
// profile (u along the winding), so every face carries its own baked tone: bright top bevel, dark seams, hammer dents,
// oxidation and verdigris in the crevices. The emissive keeps those tones readable in the dark room.
material ManaStillCoilCopper
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.85 0.85 0.85
            diffuse 1.0 1.0 1.0 1
            emissive 0.22 0.17 0.13
            specular 0.95 0.66 0.42 1 40
            texture_unit
            {
                texture ManaStillCoilCopper.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}


// Original weathered surfaces and translucent ectoplasm for the ghost room.

material GhostIron
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.65 0.65 0.65
            diffuse 0.85 0.85 0.85 1
            specular 0.24 0.22 0.18 1 18
            texture_unit
            {
                texture GhostIron.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}


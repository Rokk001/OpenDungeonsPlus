// Mana still: rusty riveted iron of the frame, funnel, bands, pipes and the crystal cradle.
material ManaStillIron
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.75 0.75 0.75
            diffuse 0.92 0.92 0.92 1
            specular 0.28 0.22 0.16 1 20
            texture_unit
            {
                texture ManaStillIron.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}

// Mana still: pale glass tube of the distilling coil.
material ManaStillCoilGlass
{
    receive_shadows off
    technique
    {
        pass
        {
            scene_blend alpha_blend
            depth_write off
            diffuse 0.62 0.70 0.64 0.30
            ambient 0.62 0.70 0.64
            specular 0.80 0.80 0.78 1 64
        }
    }
}

// Mana still (working): ectoplasm flowing through the coil and swirling in the funnel.
material ManaStillCoil
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                texture ManaStillFlow.png
                tex_address_mode wrap
                filtering trilinear
                scroll_anim -0.6 0
            }
        }
    }
}

// Mana still (working): flickering embers in the barred fire window.
material ManaStillEmbers
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                anim_texture ManaStillEmbers_0.png ManaStillEmbers_1.png ManaStillEmbers_2.png ManaStillEmbers_3.png ManaStillEmbers_4.png ManaStillEmbers_5.png 0.9
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}

// Mana still (idle): a banked, dimly glowing ember bed.
material ManaStillBanked
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                anim_texture ManaStillEmbers_3.png ManaStillEmbers_5.png ManaStillEmbers_1.png ManaStillEmbers_5.png 3.0
                tex_address_mode wrap
                filtering trilinear
                colour_op_ex modulate src_texture src_manual 0.45 0.22 0.16
            }
        }
    }
}

// Mana still (working): orange fire glow spilling out of the ember cage.
material ManaStillFireGlow
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            cull_hardware none
            cull_software none
            texture_unit
            {
                texture ManaStillGlowRamp.png
                tex_address_mode clamp
                filtering trilinear
                colour_op_ex modulate src_texture src_manual 0.85 0.34 0.07
            }
        }
    }
}

// Mana still (working): green glow of the coil column.
material ManaStillColumnGlow
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            cull_hardware none
            cull_software none
            texture_unit
            {
                texture ManaStillGlowRamp.png
                tex_address_mode clamp
                filtering trilinear
                colour_op_ex modulate src_texture src_manual 0.12 0.45 0.16
            }
        }
    }
}

// Mana still (working): green ectoplasm vapour swirling in the column and rising from the funnel.
material ManaStillVapour
{
    receive_shadows off
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off
            cull_hardware none
            cull_software none
            texture_unit
            {
                texture GhostNoise.png
                tex_address_mode wrap
                scroll_anim 0.25 0
                colour_op_ex modulate src_texture src_manual 0.20 0.65 0.24
            }
            texture_unit
            {
                texture ManaStillGlowRamp.png
                tex_address_mode clamp
                colour_op_ex modulate src_texture src_current
            }
        }
    }
}


// Mana still and mana crystal (ghost apparatus): clear glass, shimmering crystals, dusty locked glass.
material ManaCrystal
{
    receive_shadows off
    technique
    {
        pass
        {
            scene_blend alpha_blend
            depth_write off
            diffuse 0.58 0.92 0.70 0.62
            ambient 0.58 0.92 0.70
            emissive 0.18 0.40 0.24
            specular 0.55 0.65 0.58 1 48
            texture_unit
            {
                texture GhostNoise.png
                tex_address_mode wrap
                scroll_anim 0.03 0.08
                colour_op_ex modulate_x2 src_texture src_current
            }
        }
    }
}

material ManaCrystalDull
{
    receive_shadows off
    technique
    {

// Original rough infirmary furniture and shaman materials.
import RTSS/PerPixel_SinglePass from "RTShaderSystem.material"
material InfirmaryObjectWood : RTSS/PerPixel_SinglePass
{
 technique
 {
  pass
  {
   specular 0 0 0 0 1
   texture_unit
   {
    texture InfirmaryObjectWood.png
   }
  }
 }
}

// The 8x8 texture sheet carries three yellow birds in each two-second orbit phase.
material TavernDuelBirds
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
            diffuse vertexcolour
            texture_unit
            {
                texture DuelBird.png
                tex_address_mode clamp
                filtering bilinear
            }
        }
    }
}

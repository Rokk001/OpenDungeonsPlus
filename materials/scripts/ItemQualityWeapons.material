material ArmamentWeapons_common
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.5 0.5 0.5 1.0
            diffuse 1.000000 1.000000 1.000000 1
            specular 0.02 0.04 0.04 1.0 12.5
            emissive 0.0 0.0 0.0 1.0
            texture_unit
            {
                texture ArmamentWeaponsSurface.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}


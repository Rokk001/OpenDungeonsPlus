import RTSS/NormalMapping_MultiPass from "RTShaderSystem.material"
import RTSS/PerPixel_SinglePass from "RTShaderSystem.material"

material BasicAxe_common : RTSS/NormalMapping_MultiPass
{
    receive_shadows on

    technique
    {
        pass lighting
        {
            // Override the normal map.
            texture_unit
            {
                texture BasicAxeNormal.png
                rtshader_system
                {
                    normal_map object_space
                }
            }
        }

        pass decal
        {
            ambient 0.8 0.8 0.8 1.0
            diffuse 1.000000 1.000000 1.000000 1
            specular 0.0 0.0 0.0 0.0 2.0
            emissive 0.0 0.0 0.0 0.0

            texture_unit decalmap
            {
                texture BasicAxe.png
                tex_address_mode wrap
                scale 1.0 1.0
                colour_op modulate
            }
        }
    }
}

material ItemQualityMetal_common
{
 technique
 {
  pass
  {
   ambient 0.900000 0.900000 0.900000
   diffuse 0.900000 0.900000 0.900000 1
   specular 0.65 0.65 0.65 1 24
   emissive 0.000000 0.000000 0.000000
  }
 }
}



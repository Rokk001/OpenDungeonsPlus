material TavernVomit
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.05 0.05 0.05 1 12.5
            scene_blend alpha_blend
            depth_write off
            cull_hardware none
            depth_bias 1
            texture_unit
            {
                texture TavernVomit.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}

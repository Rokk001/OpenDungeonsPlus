// Original textured wood, metal, stone and figure surfaces for the tavern room.

material TavernWood
{
    receive_shadows on
    technique
    {
        pass
        {
            ambient 0.8 0.8 0.8 1
            diffuse 1 1 1 1
            specular 0.05 0.05 0.05 1 12.5
            texture_unit
            {
                texture TavernWood.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}


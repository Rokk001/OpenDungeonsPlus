// Dirt piles and blood stains (textures made by tools/gen_pile_textures.py).
// DirtPiles is the shared base; every Pile_<Type> only sets the texture of its creature type.

material DirtPiles
{
    receive_shadows on

    technique main
    {
        pass pile
        {
            ambient 0.8 0.8 0.8 1.0
            diffuse 0.75 0.75 0.75 1.0
            specular 0.0 0.0 0.0 1.0 12.5

            texture_unit decalmap
            {
                texture White.png
                tex_address_mode wrap
                filtering trilinear
            }
        }
    }
}

material Pile_Adventurer : DirtPiles
{
    technique main
    {
        pass pile
        {
            texture_unit decalmap
            {
                texture Pile_Adventurer.png
            }
        }
    }
}


            <Dim type="LeftEdge"><AbsoluteDim value="26" /></Dim>
            <Dim type="TopEdge"><AbsoluteDim value="16" /></Dim>
            <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" offset="-16" type="RightEdge" /><WidgetDim dimension="Width" widget="__auto_vscrollbar__" /></OperatorDim></Dim>
            <Dim type="BottomEdge"><UnifiedDim scale="1" offset="-16" type="BottomEdge" /></Dim>
        </Area></NamedArea>
        <NamedArea name="ItemRenderingAreaHVScroll"><Area>
            <Dim type="LeftEdge"><AbsoluteDim value="26" /></Dim>
            <Dim type="TopEdge"><AbsoluteDim value="16" /></Dim>
            <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" offset="-16" type="RightEdge" /><WidgetDim dimension="Width" widget="__auto_vscrollbar__" /></OperatorDim></Dim>
            <Dim type="BottomEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" offset="-16" type="BottomEdge" /><WidgetDim dimension="Height" widget="__auto_hscrollbar__" /></OperatorDim></Dim>
        </Area></NamedArea>
        <StateImagery name="Enabled"><Layer><Section look="OD/Listbox" section="main" /></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section look="OD/Listbox" section="main_disabled"><Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" /></Section></Layer></StateImagery>
    </WidgetLook>
    <WidgetLook name="OD/MenuMultiColumnList" inherits="OD/MultiColumnList">
        <Child nameSuffix="__auto_vscrollbar__" type="OD/MenuScrollbar">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge"><WidgetDim dimension="BottomEdge" widget="__auto_listheader__" /></Dim>
                <Dim type="Width"><OperatorDim op="Multiply"><ImageDim dimension="Width" name="OpenDungeonsSkin/MiniVertScrollThumbNormal" /><AbsoluteDim value="1.5" /></OperatorDim></Dim>
                <Dim type="BottomEdge"><UnifiedDim scale="1" offset="-12" type="BottomEdge" /></Dim>
            </Area>
            <HorzAlignment type="RightAligned" />
        </Child>
        <StateImagery name="Enabled"><Layer><Section look="OD/MultiColumnList" section="main" /></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section look="OD/MultiColumnList" section="main_disabled"><Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" /></Section></Layer></StateImagery>
    </WidgetLook>

    <!-- A symbol button sits on a forged iron plate like the corner buttons of the minimap: normal, hover as ember, pressed sunk in. -->
    <WidgetLook name="OD/MenuSymbolButton" inherits="OD/InvisibleButton">
        <ImagerySection name="plate_normal"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/ButtonTopLeftNormal" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/ButtonTopRightNormal" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/ButtonBottomLeftNormal" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/ButtonBottomRightNormal" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/ButtonLeftNormal__Edge2" />
                <Image component="RightEdge" name="OpenDungeonsSkin/ButtonRightNormal__Edge2" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/ButtonBottomNormal__Edge2" />
                <Image component="TopEdge" name="OpenDungeonsSkin/ButtonTopNormal__Edge2" />
                <Image component="Background" name="OpenDungeonsSkin/ButtonMiddleNormal" />
            </FrameComponent></ImagerySection>
        <ImagerySection name="plate_hover"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/ButtonTopLeftHighlight" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/ButtonTopRightHighlight" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/ButtonBottomLeftHighlight" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/ButtonBottomRightHighlight" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/ButtonLeftHighlight__Edge2" />
                <Image component="RightEdge" name="OpenDungeonsSkin/ButtonRightHighlight__Edge2" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/ButtonBottomHighlight__Edge2" />
                <Image component="TopEdge" name="OpenDungeonsSkin/ButtonTopHighlight__Edge2" />
                <Image component="Background" name="OpenDungeonsSkin/ButtonMiddleHighlight" />
            </FrameComponent></ImagerySection>
        <ImagerySection name="plate_pushed"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/ButtonTopLeftPushed" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/ButtonTopRightPushed" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/ButtonBottomLeftPushed" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/ButtonBottomRightPushed" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/ButtonLeftPushed__Edge2" />
                <Image component="RightEdge" name="OpenDungeonsSkin/ButtonRightPushed__Edge2" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/ButtonBottomPushed__Edge2" />
                <Image component="TopEdge" name="OpenDungeonsSkin/ButtonTopPushed__Edge2" />
                <Image component="Background" name="OpenDungeonsSkin/ButtonMiddlePushed" />
            </FrameComponent></ImagerySection>
        <ImagerySection name="symbol_normal"><ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><UnifiedDim scale="0.17" offset="0" type="Width" /></Dim>
                    <Dim type="TopEdge"><UnifiedDim scale="0.17" offset="0" type="Height" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="0.66" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="0.66" type="Height" /></Dim>
                </Area>
                <ImageProperty name="NormalImage" />
                <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
            </ImageryComponent></ImagerySection>
        <ImagerySection name="symbol_hover"><ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><UnifiedDim scale="0.17" offset="0" type="Width" /></Dim>
                    <Dim type="TopEdge"><UnifiedDim scale="0.17" offset="0" type="Height" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="0.66" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="0.66" type="Height" /></Dim>
                </Area>
                <ImageProperty name="HoverImage" />
                <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
            </ImageryComponent></ImagerySection>
        <ImagerySection name="symbol_pushed"><ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><UnifiedDim scale="0.17" offset="1" type="Width" /></Dim>
                    <Dim type="TopEdge"><UnifiedDim scale="0.17" offset="1" type="Height" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="0.66" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="0.66" type="Height" /></Dim>
                </Area>
                <ImageProperty name="PushedImage" />
                <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
            </ImageryComponent></ImagerySection>
        <StateImagery name="Normal"><Layer><Section section="plate_normal" /><Section section="symbol_normal" /></Layer></StateImagery>
        <StateImagery name="Hover"><Layer><Section section="plate_hover" /><Section section="symbol_hover" /></Layer></StateImagery>
        <StateImagery name="Pushed"><Layer><Section section="plate_pushed" /><Section section="symbol_pushed" /></Layer></StateImagery>
        <StateImagery name="PushedOff"><Layer><Section section="plate_hover_pushed" /><Section section="symbol_hover" /></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section section="plate_normal_disabled"><Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" /></Section><Section section="symbol_normal"><Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" /></Section></Layer></StateImagery>
            <ImagerySection name="plate_hover_pushed"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/ButtonTopLeftHighlight__Pushed" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/ButtonTopRightHighlight__Pushed" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/ButtonBottomLeftHighlight__Pushed" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/ButtonBottomRightHighlight__Pushed" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/ButtonLeftHighlight__Edge2__Pushed" />
                <Image component="RightEdge" name="OpenDungeonsSkin/ButtonRightHighlight__Edge2__Pushed" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/ButtonBottomHighlight__Edge2__Pushed" />
                <Image component="TopEdge" name="OpenDungeonsSkin/ButtonTopHighlight__Edge2__Pushed" />
                <Image component="Background" name="OpenDungeonsSkin/ButtonMiddleHighlight__Pushed" />
            </FrameComponent></ImagerySection>
        <ImagerySection name="plate_normal_disabled"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/ButtonTopLeftNormal__Disabled" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/ButtonTopRightNormal__Disabled" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/ButtonBottomLeftNormal__Disabled" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/ButtonBottomRightNormal__Disabled" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/ButtonLeftNormal__Edge2__Disabled" />
                <Image component="RightEdge" name="OpenDungeonsSkin/ButtonRightNormal__Edge2__Disabled" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/ButtonBottomNormal__Edge2__Disabled" />
                <Image component="TopEdge" name="OpenDungeonsSkin/ButtonTopNormal__Edge2__Disabled" />
                <Image component="Background" name="OpenDungeonsSkin/ButtonMiddleNormal__Disabled" />
            </FrameComponent></ImagerySection>
    </WidgetLook>

    <!-- Message panel of the game: the forged window frame with rivets and one even stone inset, without a title bar. -->
    <WidgetLook name="OD/EventPanel" inherits="OD/StaticText">
        <NamedArea name="WithFrameTextRenderArea">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="10" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="10" /></Dim>
                <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="RightEdge" /><AbsoluteDim value="10" /></OperatorDim></Dim>
                <Dim type="BottomEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="BottomEdge" /><AbsoluteDim value="10" /></OperatorDim></Dim>
            </Area>
        </NamedArea>
        <NamedArea name="WithFrameTextRenderAreaVScroll">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="10" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="10" /></Dim>
                <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="RightEdge" /><WidgetDim dimension="Width" widget="__auto_vscrollbar__" /></OperatorDim></Dim>
                <Dim type="BottomEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="BottomEdge" /><AbsoluteDim value="10" /></OperatorDim></Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="forged_frame">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/WindowTopLeft" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/WindowTopRight" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/WindowBottomLeft" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/WindowBottomRight" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/WindowLeftEdge" />
                <Image component="RightEdge" name="OpenDungeonsSkin/WindowRightEdge" />
                <Image component="TopEdge" name="OpenDungeonsSkin/WindowTopEdge" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/WindowBottomEdge" />
                <Image component="Background" name="OpenDungeonsSkin/ClientBrush" />
                <VertFormat type="Tiled" />
                <HorzFormat type="Tiled" />
            </FrameComponent>
        </ImagerySection>
        <StateImagery name="EnabledFrame"><Layer><Section section="forged_frame" /></Layer></StateImagery>
        <StateImagery name="DisabledFrame"><Layer><Section section="forged_frame_disabled"><Colours topLeft="FF7F7F7F" topRight="FF7F7F7F" bottomLeft="FF7F7F7F" bottomRight="FF7F7F7F" /></Section></Layer></StateImagery>
        <StateImagery name="WithFrameEnabledBackground" />
        <StateImagery name="WithFrameDisabledBackground" />
            <ImagerySection name="forged_frame_disabled">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/WindowTopLeft__Disabled" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/WindowTopRight__Disabled" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/WindowBottomLeft__Disabled" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/WindowBottomRight__Disabled" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/WindowLeftEdge__Disabled" />
                <Image component="RightEdge" name="OpenDungeonsSkin/WindowRightEdge__Disabled" />
                <Image component="TopEdge" name="OpenDungeonsSkin/WindowTopEdge__Disabled" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/WindowBottomEdge__Disabled" />
                <Image component="Background" name="OpenDungeonsSkin/ClientBrush__Disabled" />
                <VertFormat type="Tiled" />
                <HorzFormat type="Tiled" />
            </FrameComponent>
        </ImagerySection>
    </WidgetLook>

    <WidgetLook name="OD/SettingsSliderThumb" inherits="OD/HorizontalSliderThumb">
        <ImagerySection name="grip"><ImageryComponent>
            <Image name="OpenDungeonsSkin/SelectionBrush" />
            <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
        </ImageryComponent></ImagerySection>
        <StateImagery name="Normal"><Layer><Section section="grip"><Colours topLeft="FFFFFFFF" topRight="FFFFFFFF" bottomLeft="FFFFFFFF" bottomRight="FFFFFFFF" /></Section></Layer></StateImagery>
        <StateImagery name="Hover"><Layer><Section section="grip_hover" /></Layer></StateImagery>
        <StateImagery name="Pushed"><Layer><Section section="grip_pushed" /></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section section="grip_disabled"><Colours topLeft="FF777777" topRight="FF777777" bottomLeft="FF777777" bottomRight="FF777777" /></Section></Layer></StateImagery>
            <ImagerySection name="grip_hover"><ImageryComponent>
            <Image name="OpenDungeonsSkin/SelectionBrush__Hover" />
            <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
        </ImageryComponent></ImagerySection>
        <ImagerySection name="grip_pushed"><ImageryComponent>
            <Image name="OpenDungeonsSkin/SelectionBrush__Pushed" />
            <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
        </ImageryComponent></ImagerySection>
        <ImagerySection name="grip_disabled"><ImageryComponent>
            <Image name="OpenDungeonsSkin/SelectionBrush__Disabled" />
            <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
        </ImageryComponent></ImagerySection>
    </WidgetLook>
    <WidgetLook name="OD/SettingsSlider" inherits="OD/HorizontalSlider">
        <Property name="VerticalSlider" value="False" />
        <Child nameSuffix="__auto_thumb__" type="OD/SettingsSliderThumb">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="Width"><ImageDim dimension="Width" name="OpenDungeonsSkin/MiniVertScrollThumbNormal" /></Dim>
                <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
            </Area>
        </Child>
        <ImagerySection name="track"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/HorizontalSliderTopLeft" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/HorizontalSliderTopRight" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/HorizontalSliderBottomLeft" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/HorizontalSliderBottomRight" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/HorizontalSliderLeft" />
                <Image component="RightEdge" name="OpenDungeonsSkin/HorizontalSliderRight" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/HorizontalSliderBottom" />
                <Image component="TopEdge" name="OpenDungeonsSkin/HorizontalSliderTop" />
                </FrameComponent>
            </ImagerySection>
        <StateImagery name="Enabled"><Layer><Section section="track" /></Layer></StateImagery>
        <StateImagery name="Disabled"><Layer><Section section="track_disabled" /></Layer></StateImagery>
            <ImagerySection name="track_disabled"><FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/HorizontalSliderTopLeft__Disabled" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/HorizontalSliderTopRight__Disabled" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/HorizontalSliderBottomLeft__Disabled" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/HorizontalSliderBottomRight__Disabled" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/HorizontalSliderLeft__Disabled" />
                <Image component="RightEdge" name="OpenDungeonsSkin/HorizontalSliderRight__Disabled" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/HorizontalSliderBottom__Disabled" />
                <Image component="TopEdge" name="OpenDungeonsSkin/HorizontalSliderTop__Disabled" />
                </FrameComponent>
            </ImagerySection>
    </WidgetLook>
    <WidgetLook name="OD/CommunityPanel" inherits="OD/FrameWindow">
        <Property name="FrameEnabled" value="False" />
        <Property name="TitlebarEnabled" value="False" />
        <Property name="CloseButtonEnabled" value="False" />
        <ImagerySection name="backdrop">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge" /></Dim>
                    <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge" /></Dim>
                </Area>
                <Image name="OpenDungeonsSkin/SelectionBrush" />
                <Colours topLeft="E6080C10" topRight="E6080C10" bottomLeft="E6080C10" bottomRight="E6080C10" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="ActiveNoTitleNoFrame"><Layer><Section section="backdrop" /></Layer></StateImagery>
        <StateImagery name="InactiveNoTitleNoFrame"><Layer><Section section="backdrop" /></Layer></StateImagery>
        <StateImagery name="DisabledNoTitleNoFrame"><Layer><Section section="backdrop_disabled" /></Layer></StateImagery>
            <ImagerySection name="backdrop_disabled">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="RightEdge"><UnifiedDim scale="1" type="RightEdge" /></Dim>
                    <Dim type="BottomEdge"><UnifiedDim scale="1" type="BottomEdge" /></Dim>
                </Area>
                <Image name="OpenDungeonsSkin/SelectionBrush__Disabled" />
                <Colours topLeft="E6080C10" topRight="E6080C10" bottomLeft="E6080C10" bottomRight="E6080C10" />
                <VertFormat type="Stretched" />
                <HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
    </WidgetLook>

</Falagard>

    <WidgetLook name="OD/TabControl">
        <Property name="TabButtonType" value="OD/TabButton" />
        <Property name="TabTextPadding" value="{0,20}" />
        <Child nameSuffix="__auto_TabPane__" type="OD/TabContentPane">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="TopEdge">
                    <OperatorDim op="Multiply">
                        <PropertyDim name="EnableBottom" widget="__auto_TabPane__" />
                        <PropertyDim name="TabHeight" type="Height" />
                    </OperatorDim>
                </Dim>
                <Dim type="Height">
                    <OperatorDim op="Subtract">
                        <UnifiedDim scale="1" type="Height" />
                        <PropertyDim name="TabHeight" type="Height" />
                    </OperatorDim>
                </Dim>
            </Area>
        </Child>
        <Child nameSuffix="__auto_TabPane__Buttons" type="OD/TabButtonPane">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="16" /></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="1" type="Width" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="8" /></Dim>
                <Dim type="Height"><PropertyDim name="TabHeight" type="Height" /></Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
        </Child>
        <Child nameSuffix="__auto_TabPane__ScrollLeft" type="OD/SystemButton">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge">
                    <WidgetDim dimension="TopEdge" widget="__auto_TabPane__Buttons" />
                </Dim>
                <Dim type="Width">
                    <OperatorDim op="Multiply">
                        <WidgetDim dimension="Height" widget="__auto_TabPane__Buttons" />
                        <OperatorDim op="Divide">
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/TabButtonScrollLeftNormal" />
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/TabButtonScrollLeftNormal" />
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
                <Dim type="BottomEdge">
                    <WidgetDim dimension="BottomEdge" widget="__auto_TabPane__Buttons" />
                </Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="NormalImage" value="OpenDungeonsSkin/TabButtonScrollLeftNormal" />
            <Property name="HoverImage" value="OpenDungeonsSkin/TabButtonScrollLeftHover" />
            <Property name="PushedImage" value="OpenDungeonsSkin/TabButtonScrollLeftHover" />
        </Child>
        <Child nameSuffix="__auto_TabPane__ScrollRight" type="OD/SystemButton">
            <Area>
                <Dim type="Width">
                    <OperatorDim op="Multiply">
                        <WidgetDim dimension="Height" widget="__auto_TabPane__Buttons" />
                        <OperatorDim op="Divide">
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/TabButtonScrollRightNormal" />
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/TabButtonScrollRightNormal" />
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
                <Dim type="LeftEdge">
                    <OperatorDim op="Subtract"><UnifiedDim scale="1" type="Width" />
                <WidgetDim dimension="Width" widget="__auto_TabPane__ScrollRight" />
                        </OperatorDim>
                    </Dim>
                <Dim type="TopEdge">
                    <WidgetDim dimension="TopEdge" widget="__auto_TabPane__Buttons" />
                </Dim>
                <Dim type="Height"><AbsoluteDim value="0" />

                </Dim>
            </Area>
            <Property name="AlwaysOnTop" value="True" />
            <Property name="NormalImage" value="OpenDungeonsSkin/TabButtonScrollRightNormal" />
            <Property name="HoverImage" value="OpenDungeonsSkin/TabButtonScrollRightHover" />
            <Property name="PushedImage" value="OpenDungeonsSkin/TabButtonScrollRightHover" />
        </Child>
        <StateImagery name="Enabled" />
        <StateImagery name="Disabled" />
    </WidgetLook>

    <WidgetLook name="OD/MenuItem">
        <PropertyDefinition initialValue="FFF0E2C0" name="NormalTextColour" redrawOnWrite="true" />
        <PropertyDefinition initialValue="FF8C7B62" name="DisabledTextColour" redrawOnWrite="true" />
        <PropertyDefinition initialValue="FFFFFFFF" name="HoverColour" redrawOnWrite="true" />
        <PropertyDefinition initialValue="FFFFFFFF" name="PushedColour" redrawOnWrite="true" />
        <PropertyDefinition initialValue="FFFFFFFF" name="OpenedColour" redrawOnWrite="true" />
        <Property name="WantsMultiClickEvents" value="False" />
        <NamedArea name="ContentSize">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="Width">
                    <OperatorDim op="Add">
                        <FontDim type="HorzExtent" />
                        <OperatorDim op="Add">
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/MenuLeft" />
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/MenuRight" />
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
                <Dim type="Height">
                    <OperatorDim op="Add">
                        <FontDim type="LineSpacing" />
                        <OperatorDim op="Add">
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/MenuTop" />
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/MenuBottom" />
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <NamedArea name="HasPopupContentSize">
            <Area>
                <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                <Dim type="Width">
                    <OperatorDim op="Add">
                        <FontDim type="HorzExtent" />
                        <OperatorDim op="Add">
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/MenuLeft" />
                            <OperatorDim op="Add">
                                <ImageDim dimension="Width" name="OpenDungeonsSkin/MenuRight" />
                                <OperatorDim op="Multiply">
                                    <ImageDim dimension="Width" name="OpenDungeonsSkin/PopupMenuArrowLeft" />
                                    <AbsoluteDim value="3" />
                                </OperatorDim>
                            </OperatorDim>
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
                <Dim type="Height">
                    <OperatorDim op="Add">
                        <FontDim type="LineSpacing" />
                        <OperatorDim op="Add">
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/MenuTop" />
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/MenuBottom" />
                        </OperatorDim>
                    </OperatorDim>
                </Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="label">
            <TextComponent>
                <Area>
                    <Dim type="LeftEdge"><ImageDim dimension="Width" name="OpenDungeonsSkin/MenuLeft" /></Dim>
                    <Dim type="TopEdge"><ImageDim dimension="Height" name="OpenDungeonsSkin/MenuTop" /></Dim>
                    <Dim type="RightEdge">
                        <OperatorDim op="Subtract">
                            <UnifiedDim scale="1" type="RightEdge" />
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/MenuRight" />
                        </OperatorDim>
                    </Dim>
                    <Dim type="BottomEdge">
                        <OperatorDim op="Subtract">
                            <UnifiedDim scale="1" type="BottomEdge" />
                            <ImageDim dimension="Height" name="OpenDungeonsSkin/MenuBottom" />
                        </OperatorDim>
                    </Dim>
                </Area>
                <VertFormat type="CentreAligned" />
                <HorzFormat type="LeftAligned" />
            </TextComponent>
        </ImagerySection>
        <ImagerySection name="frame">
            <FrameComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width"><UnifiedDim scale="1" type="Width" /></Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>
                </Area>
                <Image component="TopLeftCorner" name="OpenDungeonsSkin/MenuTopLeft" />
                <Image component="TopRightCorner" name="OpenDungeonsSkin/MenuTopRight" />
                <Image component="BottomLeftCorner" name="OpenDungeonsSkin/MenuBottomLeft" />
                <Image component="BottomRightCorner" name="OpenDungeonsSkin/MenuBottomRight" />
                <Image component="LeftEdge" name="OpenDungeonsSkin/MenuLeft" />
                <Image component="RightEdge" name="OpenDungeonsSkin/MenuRight" />
                <Image component="TopEdge" name="OpenDungeonsSkin/MenuTop" />
                <Image component="BottomEdge" name="OpenDungeonsSkin/MenuBottom" />
                <Image component="Background" name="OpenDungeonsSkin/MenuMiddle" />
            </FrameComponent>
        </ImagerySection>
        <ImagerySection name="popup_arrow_right">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="TopEdge"><AbsoluteDim value="0" /></Dim>
                    <Dim type="Width">
                        <OperatorDim op="Subtract">
                            <UnifiedDim scale="1" type="Width" />
                            <ImageDim dimension="Width" name="OpenDungeonsSkin/PopupMenuArrowRight" />
                        </OperatorDim>
                    </Dim>
                    <Dim type="Height"><UnifiedDim scale="1" type="Height" /></Dim>

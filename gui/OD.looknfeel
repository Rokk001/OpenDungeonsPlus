    <WidgetLook name="OD/ResourceDisplay" inherits="OD/StaticText">
        <NamedArea name="WithFrameTextRenderArea">
            <Area>
                <Dim type="LeftEdge"><UnifiedDim scale="0.33" type="LeftEdge" /></Dim>
                <Dim type="TopEdge"><ImageDim dimension="Height" name="OpenDungeonsSkin/StaticTop" /></Dim>
                <Dim type="RightEdge"><UnifiedDim scale="0.92" type="RightEdge" /></Dim>
                <Dim type="BottomEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="BottomEdge" /><ImageDim dimension="Height" name="OpenDungeonsSkin/StaticBottom" /></OperatorDim></Dim>
            </Area>
        </NamedArea>
        <ImagerySection name="inset">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><ImageDim name="OpenDungeonsSkin/ButtonLeftNormal" dimension="Width" /></Dim>
                    <Dim type="TopEdge"><ImageDim name="OpenDungeonsSkin/ButtonTopNormal" dimension="Height" /></Dim>
                    <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="RightEdge" /><ImageDim name="OpenDungeonsSkin/ButtonRightNormal" dimension="Width" /></OperatorDim></Dim>
                    <Dim type="BottomEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="BottomEdge" /><ImageDim name="OpenDungeonsSkin/ButtonBottomNormal" dimension="Height" /></OperatorDim></Dim>
                </Area>
                <Image name="OpenDungeonsSkin/SelectionBrush" />
                <Colours topLeft="FF2E2117" topRight="FF221810" bottomLeft="FF120C08" bottomRight="FF0C0806" />
                <VertFormat type="Stretched" /><HorzFormat type="Stretched" />
            </ImageryComponent>
        </ImagerySection>
        <StateImagery name="EnabledFrame"><Layer><Section look="OD/GameTabButton" section="navigation_frame"><Colours topLeft="FFC98F55" topRight="FFA9703F" bottomLeft="FF8A5A32" bottomRight="FF6E4626" /></Section></Layer></StateImagery>
        <StateImagery name="DisabledFrame"><Layer><Section look="OD/GameTabButton" section="navigation_frame_disabled"><Colours topLeft="FFC98F55" topRight="FFA9703F" bottomLeft="FF8A5A32" bottomRight="FF6E4626" /></Section></Layer></StateImagery>
        <StateImagery name="WithFrameEnabledBackground"><Layer><Section section="inset" /></Layer></StateImagery>
        <StateImagery name="WithFrameDisabledBackground"><Layer><Section section="inset_disabled" /></Layer></StateImagery>
            <ImagerySection name="inset_disabled">
            <ImageryComponent>
                <Area>
                    <Dim type="LeftEdge"><ImageDim name="OpenDungeonsSkin/ButtonLeftNormal__Disabled" dimension="Width" /></Dim>
                    <Dim type="TopEdge"><ImageDim name="OpenDungeonsSkin/ButtonTopNormal__Disabled" dimension="Height" /></Dim>
                    <Dim type="RightEdge"><OperatorDim op="Subtract"><UnifiedDim scale="1" type="RightEdge" /><ImageDim name="OpenDungeonsSkin/ButtonRightNormal__Disabled" dimension="Width" /></OperatorDim></Dim>

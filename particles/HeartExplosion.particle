// Heart explosion of the defeat sequence. The node sits at the middle of the destroyed heart.
// Fireballs (red to yellow, big and slow) and green sparks (fast, small lifetime) share one
// material because a script has only one; both emitters run until the sequence removes the effect.
particle_system HeartExplosion
{
    material        CombatSparks
    point_rendering false
    particle_width  0.9
    particle_height 0.9
    cull_each       false
    quota           600
    billboard_type  point

    // Fireballs
    emitter Box
    {
        angle               70
        colour_range_start  1.0 0.25 0.05 1.0
        colour_range_end    1.0 0.75 0.15 1.0
        emission_rate       28
        time_to_live_min    0.9
        time_to_live_max    1.8
        direction           0 0 1
        velocity_min        0.8
        velocity_max        3.2
        width               2.2
        height              2.2
        depth               0.2
    }

    // Green sparks
    emitter Point
    {
        angle               180
        colour_range_start  0.2 1.0 0.3 1.0
        colour_range_end    0.6 1.0 0.5 1.0
        emission_rate       45
        time_to_live_min    0.6
        time_to_live_max    1.4
        direction           0 0 1
        velocity_min        2.0
        velocity_max        6.0
    }

    affector LinearForce
    {
        force_vector      0 0 -2.5
        force_application add
    }

    affector ColourFader
    {
        alpha -0.7
    }
}

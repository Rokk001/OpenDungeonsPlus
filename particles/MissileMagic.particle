
particle_system MissileMagic
{
    material MissileMagic
    point_rendering            false
    particle_width             0.16
    particle_height            0.16
    cull_each                  false
    quota                      64
    billboard_type             point

    emitter Point
    {
        angle                   0
        colour                  0.55 0.8 1 1
        emission_rate           120
        time_to_live            0.12
        velocity                0
    }

    affector ColourFader
    {
        red                     -3.5
        green                   -4.5
        blue                    -4.5
        alpha                   -8
    }
}

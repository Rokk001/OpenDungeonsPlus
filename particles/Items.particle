// A brief coloured laboratory puff; existing original smoke sprites are reused.
particle_system CauldronSmoke
{
    material RoomAmbSmoke
    particle_width 0.45
    particle_height 0.45
    quota 30
    billboard_type point
    emitter Point
    {
        angle 35
        colour_range_start 0.28 0.65 0.18 0.65
        colour_range_end 0.56 0.40 0.65 0.45
        emission_rate 35
        time_to_live 1.6
        direction 0 0 1
        velocity_min 0.35
        velocity_max 0.70
        duration 0.55
        position 0 0 0.80
    }
    affector ColourFader { alpha -0.45 }
    affector Scaler { rate 0.35 }
}

// Reuse the project's original short spark shower for opening an item box.
particle_system CrackSparks
{
    material ReactionParticleSpark
    point_rendering false
    particle_width 0.2
    particle_height 0.2
    cull_each false
    quota 40
    billboard_type point
    emitter Box
    {
        angle 180
        colour_range_start 1.0 0.9 0.5 1.0
        colour_range_end 1.0 1.0 0.8 1.0
        emission_rate 40
        time_to_live 0.7
        direction 0 0 1
        velocity_min 0.3
        velocity_max 1.0
        duration 0.9
        position 0 0 0.7
        width 0.6
        height 0.6
        depth 0.6
    }
    affector ColourFader { alpha -1.4 }
}

// Gentle drifting luminous specks over the underground herb beds.
particle_system Glowbeetle
{
    material RoomAmbGlow
    particle_width 0.055
    particle_height 0.055
    quota 16
    billboard_type point
    emitter Box
    {
        angle 180
        colour_range_start 0.65 0.90 0.22 0.0
        colour_range_end 0.90 1.0 0.45 0.0
        emission_rate 1.5
        time_to_live 7
        direction 0 0 1
        velocity_min 0.03
        velocity_max 0.08
        position 0 0 0.4
        width 1.2
        height 1.2
        depth 0.7
    }
    affector ColourInterpolator
    {
        time0 0
        colour0 0.65 0.90 0.22 0.0
        time1 0.4
        colour1 0.80 1.0 0.32 0.80
        time2 1
        colour2 0.65 0.90 0.22 0.0
    }
    affector DirectionRandomiser
    {
        randomness 0.20
        scope 0.8
        keep_velocity true
    }
}

// Swirl of the defeat sequence. The sequence sets the emitter colour to the conqueror's seat colour
// at runtime and moves the node across the floor, so this script has no colour of its own.
particle_system DefeatSwirl
{
    material        CombatSparks
    point_rendering false
    particle_width  0.35
    particle_height 0.35
    cull_each       false
    quota           400
    billboard_type  point

    emitter Ring
    {
        angle               25
        colour_range_start  1.0 1.0 1.0 1.0
        colour_range_end    1.0 1.0 1.0 1.0
        emission_rate       130
        time_to_live_min    0.8
        time_to_live_max    1.4
        direction           0 0 1
        velocity_min        0.8
        velocity_max        2.0
        width               2.0
        height              2.0
        inner_width         0.7
        inner_height        0.7
    }

    affector DirectionRandomiser
    {
        randomness      4
        scope           1
        keep_velocity   true
    }

    affector ColourFader
    {
        alpha -0.9
    }
}

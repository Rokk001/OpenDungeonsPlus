{
    material RoomAmbSpark
    particle_width 0.045
    particle_height 0.045
    quota 64
    billboard_type point
    emitter Point
    {
        angle 180
        colour 0.7 1.0 0.8 0.9
        emission_rate 35
        duration 0.1
        time_to_live 0.1
        direction 0 0 1
        velocity_min 0.05
        velocity_max 0.2
    }
    affector ColourFader
    {
        alpha -9.000000
    }
}

// A short green puff lasting half a second.
particle_system EctoplasmBurst
{
    material RoomAmbSmoke
    particle_width 0.25

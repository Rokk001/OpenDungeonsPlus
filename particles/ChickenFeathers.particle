// Feathers that fly up and tumble down. Hen: white with grey and a few black ones (the tail). The texture is the
// feather of materials/textures/ChickenFeather.png, the colours of the emitters are the plumage.
particle_system ChickenFeathers
{
    material ChickenFeathers
    particle_width 0.17
    particle_height 0.17
    quota 16
    billboard_type point
    emitter Point
    {
        angle 80
        colour_range_start 1.0 1.0 1.0 1.0
        colour_range_end 0.92 0.92 0.9 1.0
        emission_rate 40
        time_to_live_min 1.6
        time_to_live_max 2.3
        direction 0 0 1
        velocity_min 0.6
        velocity_max 1.4
        duration 0.15
    }
    emitter Point
    {
        angle 80
        colour_range_start 0.7 0.7 0.72 1.0
        colour_range_end 0.55 0.55 0.58 1.0
        emission_rate 20
        time_to_live_min 1.6
        time_to_live_max 2.3
        direction 0 0 1
        velocity_min 0.6
        velocity_max 1.4
        duration 0.15
    }
    emitter Point
    {
        angle 80
        colour_range_start 0.16 0.16 0.18 1.0
        colour_range_end 0.1 0.1 0.12 1.0
        emission_rate 14
        time_to_live_min 1.6
        time_to_live_max 2.3
        direction 0 0 1
        velocity_min 0.6
        velocity_max 1.4
        duration 0.15
    }
    affector LinearForce
    {
        force_vector 0.1 0 -0.8
        force_application add
    }
    affector DirectionRandomiser
    {
        randomness 1.6
        scope 0.6
        keep_velocity true
    }
    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start -220
        rotation_speed_range_end 220
    }
    affector ColourFader
    {
        alpha -0.4
    }
}

// Green motes rise and fade within 1.5 seconds.
particle_system GhostRise
{
    material RoomAmbGlow
    particle_width 0.07
    particle_height 0.07
    quota 64
    billboard_type point
    emitter Point
    {
        angle 35
        colour 0.4 1.0 0.5 0.8
        emission_rate 90
        duration 0.2
        time_to_live 1.3
        direction 0 0 1
        velocity_min 0.2
        velocity_max 0.55
    }
    affector ColourFader
    {
        alpha -0.615385
    }
}


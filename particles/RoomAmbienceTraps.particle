// Effects of the trap types and door types that share one mesh
// (see config/roomAmbienceTraps.cfg). Only existing textures and materials of the room ambience are used.

// ---------------------------------------------------------------- Alarm

// A small light that pulses slowly
particle_system RoomAmbAlarmLight
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.32
    particle_height 0.32
    cull_each       false
    quota           2
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.25 0.15 0.0
        emission_rate       0.8
        time_to_live        1.4
        direction           0 0 1
        velocity            0
        position            0 0 0.2
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 0.25 0.15 0.0
        time1   0.5
        colour1 1.0 0.25 0.15 0.85
        time2   1
        colour2 1.0 0.25 0.15 0.0
    }
}

// A fast flashing light while someone is close
particle_system RoomAmbAlarmFlash
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.0
    particle_height 1.0
    cull_each       false
    quota           4
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.3 0.12 0.8
        emission_rate       4
        time_to_live        0.3
        direction           0 0 1
        velocity            0
        position            0 0 0.3
    }

    affector ColourFader
    {
        alpha   -2.6
    }
}

// Rings that spread outward over the floor
particle_system RoomAmbAlarmRing
{
    material        RoomAmbGlow

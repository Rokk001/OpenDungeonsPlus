        direction           0 0 1
        velocity_min        0.3
        velocity_max        0.9
        position            0 0 0.4
        width               0.8
        height              0.5
        depth               0.6
        duration            0.35
        repeat_delay_min    5
        repeat_delay_max    6
    }

    affector Scaler
    {
        rate    0.5
    }

    affector ColourFader
    {
        alpha   -0.5
    }
}

// ---------------------------------------------------------------- Locked doors, secret doors found

// A door that the keeper has locked: a slow red glow at the lock
particle_system RoomAmbLockGlow
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  0.55
    particle_height 0.55
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.3 0.18 0.0
        emission_rate       0.8
        time_to_live        2.0
        direction           0 0 1
        velocity            0
        position            0.4 0 0.65
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 0.3 0.18 0.0
        time1   0.4
        colour1 1.0 0.3 0.18 0.7
        time2   1
        colour2 1.0 0.3 0.18 0.0
    }
}

// A secret door that is shown to a keeper: its outline lights up for a moment
particle_system RoomAmbRevealGlow
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.5
    particle_height 1.5
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1.0 0.85 0.45 0.0
        emission_rate       6
        time_to_live        1.4
        direction           0 0 1
        velocity            0
        position            0 0 0.5
        duration            0.3
        repeat_delay_min    5
        repeat_delay_max    6
    }

    affector ColourInterpolator
    {
        time0   0
        colour0 1.0 0.85 0.45 0.0
        time1   0.3
        colour1 1.0 0.85 0.45 0.75
        time2   1
        colour2 1.0 0.85 0.45 0.0
    }
}

// Toxic Cloud: a low, mottled poisonous cloud for the radius-1.5 creature ability.
// The local footprint plus billboard half-diagonal stays inside that radius at every configured level scale.
// The existing creature-effect lifecycle removes the whole system after two game turns,
// including live billboards; there is no wall-clock duration that could desynchronise at another game speed.
particle_system CreatureToxicCloud
{
    material        CreatureToxicCloud
    point_rendering false
    particle_width  0.55
    particle_height 0.55
    cull_each       false
    quota           64
    local_space     true
    billboard_type  point

    emitter Ellipsoid
    {
        angle               0
        colour              0.31 0.53 0.10 0.28
        emission_rate       110
        time_to_live        0.5
        direction           0 0 1
        velocity            0
        position            0 0 0.4
        width               1.9
        height              1.9
        depth               0.2
    }

    affector ColourInterpolator
    {
        time0   0.0
        colour0 0.31 0.53 0.10 0.0
        time1   0.15
        colour1 0.31 0.53 0.10 0.28
        time2   0.65
        colour2 0.24 0.43 0.07 0.23
        time3   1.0
        colour3 0.16 0.29 0.04 0.0
    }

    affector Rotator
    {
        rotation_range_start       0
        rotation_range_end         360
        rotation_speed_range_start -25
        rotation_speed_range_end   25
    }
}

// More cosmetic effects of the spells (client side): own cast markers, travel and impact looks for the
// healing, haste, defense and slow spells, the flight trails of the thrown spells, the ends of the
// defector and possession spells. Started by config/roomAmbienceSpells.cfg. Only existing sprites.

// Healing: gold flash at the target (cast marker)
particle_system SpFxHealMark
{
    material        RoomAmbGlow
    point_rendering false
    particle_width  1.1
    particle_height 1.1
    cull_each       false
    quota           3
    billboard_type  point

    emitter Point
    {
        angle               0
        colour              1 0.85 0.4 0.9
        emission_rate       10
        time_to_live        0.5
        direction           0 0 1
        velocity            0
        position            0 0 0.7
        duration            0.1
    }

    affector Scaler
    {
        rate                1.2
    }

    affector ColourFader
    {
        alpha               -2.0
    }
}

// Healing: a golden ring on the floor

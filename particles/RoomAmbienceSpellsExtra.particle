// Pale-green elongated shards disperse within 0.6 seconds.
particle_system SoulCrystalBreak
{
    material GhostShard
    particle_width 0.04
    particle_height 0.14
    quota 64
    billboard_type point
    emitter Point
    {
        angle 180
        colour 0.7 1.0 0.8 0.9
        emission_rate 200
        duration 0.05
        time_to_live 0.55
        direction 0 0 1
        velocity_min 0.6
        velocity_max 1.6
    }
    affector ColourFader
    {
        alpha -1.636364
    }
    affector Rotator
    {
        rotation_range_start 0
        rotation_range_end 360
        rotation_speed_range_start -180
        rotation_speed_range_end 180
    }
}


// PC menu effects: all configured systems total at most 1,968 particles, including five grave emitters.
// Continuous fire, low grave fog, windblown embers and the tower's vertical green shaft.
particle_system MenuBrazierFire
{
    material Flame
    particle_width 0.42
    particle_height 1.05
    quota 180
    billboard_type point
    sorted true
    emitter Box
    {
        position 0 0 3.6
        width 0.85
        height 0.85
        depth 0.05
        direction 0 0 1
        angle 18
        emission_rate 78
        time_to_live_min 0.25
        time_to_live_max 0.75
        velocity_min 0.55
        velocity_max 1.75
        colour_range_start 1 0.36 0.04 0.95
        colour_range_end 0.85 0.12 0.015 0.7
    }
    affector ColourFader
    {
        red -0.6
        green -0.6
        blue -0.12
        alpha -1.0
    }
    affector Scaler
    {
        rate -0.55
    }
}


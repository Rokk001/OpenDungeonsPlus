// Transparent generated bats cross the far red horizon; the particle quota limits alpha overdraw.
particle_system MenuBatSwarm
{
    material MenuBatSprite
    particle_width 0.95
    particle_height 0.95
    quota 64
    sorted true
    billboard_type point
    emitter Box
    {
        position 25 61 23
        width 26
        height 20
        depth 11
        direction -1 0.12 0.03
        angle 16
        emission_rate 5
        time_to_live_min 7
        time_to_live_max 11
        velocity_min 0.7
        velocity_max 1.7
        colour_range_start 0.045 0.04 0.03 0.9
        colour_range_end 0.025 0.022 0.018 0.7
    }
    affector Rotator
    {
        rotation_range_start -15
        rotation_range_end 15
        rotation_speed_range_start -8
        rotation_speed_range_end 8
    }
    affector ColourFader { alpha -0.06 }
}


 #
+# Store the type of a target in a variable, or leave it empty when the target does not exist
+# (get_target_property on a missing target is an error with current CMake versions)
+macro (cegui_target_type _VAR _TARGET)
+    if (TARGET ${_TARGET})
+        get_target_property(${_VAR} ${_TARGET} TYPE)
+    else()
+        set(${_VAR})
+    endif()
+endmacro()
+

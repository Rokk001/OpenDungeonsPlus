 namespace Ogre {

+    //! Clears both caches when their owning program is recreated or relinked.
     void GLUniformCache::clearCache()
     {
+        mExactUniformValueMap.clear();
 #ifdef OGRE_ENABLE_STATE_CACHE
         mUniformValueMap.clear();
 #endif
+    }
+
+    //! Suppresses only byte-identical uploads to the same linked program and orientation.
+    bool GLUniformCache::updateUniformExact(int location, const void* value, size_t length, bool transpose)
+    {
+        ExactUniformValue& cached = mExactUniformValueMap[location];
+        if(cached.second.size() == length && cached.first == transpose &&
+            length != 0 && std::memcmp(cached.second.data(), value, length) == 0)
+            return false;
+        cached.first = transpose;
+        cached.second.resize(length);
+        if(length != 0)
+            std::memcpy(cached.second.data(), value, length);
+        return true;
     }

     bool GLUniformCache::updateUniform(int location, const void *value, int length)
     {
 #ifdef OGRE_ENABLE_STATE_CACHE
         uint32 current = mUniformValueMap[location];
         uint32 hash = Ogre::FastHash((const char *)value, length);
         // First check if the uniform name is in the map. If not, this is new so insert it into the map.
         if (!current || (current != hash))
         {
             // Haven't cached this state yet or the value has changed
             mUniformValueMap[location] = hash;
